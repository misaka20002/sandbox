# 鉴权 Token（二选一，SANDBOX_TOKEN 优先）
# 首选：直接填明文 Token，服务端启动时自动做 SHA-256。适合 Vercel 环境变量 / 一键部署。
SANDBOX_TOKEN=replace_with_your_single_bearer_token
# 可选：预先算好的 SHA-256 摘要，作为镜像默认值；仅在未设置 SANDBOX_TOKEN 时生效。
SANDBOX_TOKEN_SHA256=replace_with_sha256_of_your_single_bearer_token
MAX_CONCURRENT_JOBS=2
DEFAULT_TIMEOUT_SECONDS=120
MAX_TIMEOUT_SECONDS=300
MAX_OUTPUT_BYTES=2000000
MAX_INPUT_BYTES=20000000
MAX_FILE_OUTPUT_BYTES=20000000
MAX_STREAM_FILE_OUTPUT_BYTES=64000000
MAX_OUTPUT_FILES=8
